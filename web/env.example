# Copy to web/.env.production and fill in. Find these values in the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# The web API key is public by design (it identifies the project; it grants nothing).
# Never set VITE_USE_AUTH_EMULATOR here: the deploy refuses to build if it is true.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
